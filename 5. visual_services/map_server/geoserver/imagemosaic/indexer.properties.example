# Copy into a GeoServer ImageMosaic store directory as indexer.properties.
# The mosaic's raster files must be georeferenced GeoTIFFs in that directory.
Schema=*the_geom:Polygon,location:String,time:java.util.Date
PropertyCollectors=TimestampFileNameExtractorSPI[timeregex](time)
TimeAttribute=time
Caching=false
AbsolutePath=false
Recursive=true
Wildcard=*.tif
