# Cantaloupe 5.x baseline for private MinIO-backed IIIF Image API 3 delivery.
# Supply AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY through the runtime.
# Keep this listener private and terminate TLS/authentication at a trusted proxy.
http.enabled = true
http.host = 127.0.0.1
http.port = 8182
https.enabled = false
base_uri =

endpoint.iiif.1.enabled = false
endpoint.iiif.2.enabled = false
endpoint.iiif.3.enabled = true
endpoint.admin.enabled = false
endpoint.api.enabled = false

max_pixels = 10000000
max_scale = 1.0
print_stack_trace_on_error_pages = false
headers.powered_by.display = false

source.static = S3Source
source.delegate = false
S3Source.endpoint = http://minio:9000
S3Source.region = us-east-1
S3Source.access_key_id =
S3Source.secret_key =
S3Source.lookup_strategy = BasicLookupStrategy
S3Source.BasicLookupStrategy.bucket.name = pleroma-media
S3Source.BasicLookupStrategy.path_prefix = iiif-pyramids/
S3Source.BasicLookupStrategy.path_suffix =
S3Source.chunking.enabled = true

processor.selection_strategy = AutomaticSelectionStrategy
processor.stream_retrieval_strategy = StreamStrategy

cache.client.enabled = true
cache.client.public = false
cache.client.private = true
cache.client.no_store = true
cache.server.derivative.enabled = true
cache.server.derivative = FilesystemCache
FilesystemCache.pathname = /var/cache/cantaloupe

