    skos:prefLabel "Pleroma controlled vocabularies"@en ;
    dcterms:source "Project Aletheion / Pleroma Guidelines v1.0, sections 3.3, 3.5, and 4" .

<https://pleroma.project-aletheion.org/vocab/object-type/>
    a skos:ConceptScheme ;
    skos:prefLabel "Object types"@en ;
